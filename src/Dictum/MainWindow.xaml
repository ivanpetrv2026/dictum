<Window x:Class="Dictum.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе"
        Height="280"
        Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="Dictum" FontSize="26" FontWeight="Bold" />
        <TextBlock Margin="0,4,0,18"
                   Foreground="#666"
                   Text="Локальная диктовка на Whisper. Без облака, без глобального хука клавиатуры." 
                   TextWrapping="Wrap" />
        <TextBlock Text="Версия 0.2.5" />
        <TextBlock Margin="0,6,0,0" Foreground="#666" Text="Лицензия MIT" />
    </StackPanel>
</Window>
