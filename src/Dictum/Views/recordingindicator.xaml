<Window x:Class="Dictum.Views.RecordingIndicator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="140"
        Height="140"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None">
    <Grid>
        <Ellipse x:Name="Halo"
                 Width="96"
                 Height="96"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="#557C5CFF"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="HaloScale" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse Width="52"
                 Height="52"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="#7C5CFF"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="DotScale" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse Width="22"
                 Height="22"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="White" />
    </Grid>
</Window>
