<Window x:Class="Dictum.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dictum — панель управления"
        Height="800"
        Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="Дашборд">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="44" Height="44" VerticalAlignment="Center" Source="/app.ico" />
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="22" FontWeight="Bold" Text="Dictum" />
                                <TextBlock x:Name="DashSubtitle" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <UniformGrid Margin="0,20,0,0" Columns="3">
                            <Border Margin="0,0,6,0" Padding="14" Background="{StaticResource SurfaceBrush}" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock x:Name="DashToday" FontSize="28" FontWeight="Bold" />
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="диктовок сегодня" />
                                </StackPanel>
                            </Border>
                            <Border Margin="3,0,3,0" Padding="14" Background="{StaticResource SurfaceBrush}" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock x:Name="DashTotal" FontSize="28" FontWeight="Bold" />
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="всего" />
                                </StackPanel>
                            </Border>
                            <Border Margin="6,0,0,0" Padding="14" Background="{StaticResource SurfaceBrush}" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock x:Name="DashGateway" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="активный шлюз" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Margin="0,12,0,0" Padding="14" Background="{StaticResource SurfaceBrush}" CornerRadius="10">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Ключи шлюзов" />
                                <TextBlock x:Name="DashKeysText" Margin="0,6,0,0" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                            <Button x:Name="TestButton" Width="170" Content="Проверить связь" Style="{StaticResource PrimaryButton}" Click="OnTestClick" />
                            <Button x:Name="BenchmarkButton" Width="170" Margin="8,0,0,0" Content="Проверить качество" Click="OnBenchmark" />
                            <Button x:Name="ContextBenchmarkButton" Width="150" Margin="8,0,0,0" Content="Мои фразы" Click="OnContextBenchmark" />
                            <TextBlock x:Name="TestResultText"
                                       Margin="12,0,0,0"
                                       MaxWidth="500"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Button x:Name="OpenTranscriptsButton" Width="230" Content="Открыть папку с текстами" Click="OnOpenTranscripts" />
                            <Button x:Name="CopyLastButton" Width="190" Margin="8,0,0,0" Content="Копировать последнюю" Click="OnCopyLast" />
                            <TextBlock x:Name="TranscriptsPathText"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Margin="0,22,0,8" FontWeight="SemiBold" Text="Последние диктовки" />
                        <TextBox x:Name="DashRecentText"
                                 MinHeight="110"
                                 Padding="10"
                                 AcceptsReturn="True"
                                 Background="White"
                                 BorderBrush="{StaticResource BorderBrushSoft}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Модели">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock FontSize="18" FontWeight="Bold" Text="Модели распознавания" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="Файлы хранятся в %LOCALAPPDATA%\Dictum\models и работают офлайн. Чем больше модель, тем выше точность и тем больше видеопамяти она занимает." />

                        <ProgressBar x:Name="ModelProgress" Height="8" Margin="0,16,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="ModelStatus"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" />

                        <StackPanel x:Name="ModelsPanel" Margin="0,16,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Ключи">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock FontSize="18" FontWeight="Bold" Text="Ключи API" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="Ключи хранятся в Windows Credential Manager: шифрование DPAPI, привязка к учётной записи, в settings.json и в логах их нет. Поле ввода никогда не показывает сохранённый ключ — только статус. Проверка обращения к шлюзу засчитывается по списку моделей." />
                        <StackPanel x:Name="KeysPanel" Margin="0,16,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Профили">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock FontSize="18" FontWeight="Bold" Text="Профили приложений" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="По одному профилю в строке: «Название | совпадения через запятую | стиль». Совпадение ищется по имени процесса (code, telegram, outlook). Стиль уходит в ИИ-очистку, а подсказка для Whisper берётся из сохранённого профиля с тем же названием." />
                        <TextBox x:Name="ProfilesBox"
                                 Height="150"
                                 Margin="0,14,0,0"
                                 AcceptsReturn="True"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" />
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="Пример: Код | code, devenv, rider | Технический стиль, сохраняй имена функций и переменных." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Настройки">                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Margin="0,0,0,6" FontWeight="SemiBold" Text="Путь к модели Whisper (.bin)" />

                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ModelPathBox" Grid.Column="0" />
                            <Button Grid.Column="1" Width="100" Margin="8,0,0,0" Content="Обзор…" Click="OnBrowse" />
                        </Grid>

                        <TextBlock Grid.Row="2" Margin="0,0,0,6" FontWeight="SemiBold" Text="Язык распознавания" />

                        <ComboBox x:Name="LanguageBox" Grid.Row="3" Width="220" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <ComboBoxItem Content="ru" />
                            <ComboBoxItem Content="en" />
                            <ComboBoxItem Content="auto" />
                        </ComboBox>

                        <Grid Grid.Row="4" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Словарь терминов" />
                            <CheckBox x:Name="LearnBox" Grid.Column="1" Content="Учить мои исправления" />
                        </Grid>

                        <TextBox x:Name="TermsBox"
                                 Grid.Row="5"
                                 Height="150"
                                 AcceptsReturn="True"
                                 AcceptsTab="False"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" />

                        <Border Grid.Row="6" Margin="0,14,0,0" Padding="14" Background="{StaticResource SurfaceBrush}" CornerRadius="10">
                            <StackPanel>
                                <CheckBox x:Name="AiBox" FontWeight="SemiBold" Content="ИИ-очистка текста через шлюз" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Text="Выключено по умолчанию. При включении распознанный текст одной диктовки уходит по HTTPS на выбранный шлюз. Других сетевых соединений приложение не делает." />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="Шлюз:" />
                                    <ComboBox x:Name="AiProviderBox" Grid.Column="1" SelectionChanged="OnProviderChanged">
                                        <ComboBoxItem Content="OpenRouter" Tag="openrouter" />
                                        <ComboBoxItem Content="OrcaRouter" Tag="orcarouter" />
                                        <ComboBoxItem Content="TeamRouter" Tag="teamorouter" />
                                        <ComboBoxItem Content="Bynara" Tag="bynara" />
                                        <ComboBoxItem Content="Gemini" Tag="gemini" />
                                        <ComboBoxItem Content="Другой" Tag="custom" />
                                    </ComboBox>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,8,0" Text="Модель:" />
                                    <ComboBox x:Name="AiModelBox" Grid.Column="3" IsEditable="True" />                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="Endpoint:" />
                                    <TextBox x:Name="AiBaseUrlBox" Grid.Column="1" />
                                </Grid>

                                <CheckBox x:Name="AiFallbackBox"
                                          Margin="0,10,0,0"
                                          Content="Резервный шлюз Gemini, если основной не ответил" />

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="Модель Gemini:" />
                                    <TextBox x:Name="AiFallbackModelBox" Grid.Column="1" />
                                </Grid>

                                <CheckBox x:Name="SaveTranscriptsBox"
                                          Margin="0,12,0,0"
                                          Content="Сохранять распознанные тексты в txt по дням" />
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="7"
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="Словарь: по одному термину в строке, формат «Канонично | вариант1, вариант2». Ключи берутся из переменных окружения или из хранилища учётных данных Windows." />
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="110" Margin="0,0,8,0" Content="Отмена" Click="OnCancel" />
            <Button Width="120" Content="Сохранить" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
