<Window x:Class="Dictum.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dictum — настройки"
        Height="580"
        Width="680"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,6"
                   FontWeight="SemiBold"
                   Text="Путь к модели Whisper (.bin)" />

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ModelPathBox" Grid.Column="0" Padding="6" VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Width="96" Margin="8,0,0,0" Content="Обзор…" Click="OnBrowse" />
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="0,0,0,6"
                   FontWeight="SemiBold"
                   Text="Язык распознавания" />

        <ComboBox x:Name="LanguageBox" Grid.Row="3" Width="220" HorizontalAlignment="Left" Margin="0,0,0,14">
            <ComboBoxItem Content="ru" />
            <ComboBoxItem Content="en" />
            <ComboBoxItem Content="auto" />
        </ComboBox>

        <Grid Grid.Row="4" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Словарь терминов" />
            <CheckBox x:Name="LearnBox" Grid.Column="1" Content="Учить мои исправления" />
        </Grid>

        <TextBox x:Name="TermsBox"
                 Grid.Row="5"
                 AcceptsReturn="True"
                 AcceptsTab="False"
                 FontFamily="Consolas"
                 FontSize="13"
                 Padding="6"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />

        <TextBlock Grid.Row="6"
                   Margin="0,10,0,10"
                   Foreground="#666"
                   TextWrapping="Wrap"
                   Text="По одному термину в строке. Формат: «Канонично | вариант1, вариант2». Варианты — то, как Whisper или ты произносишь термин («click house», «жир»). Словарь уходит в подсказку модели и правит текст после распознавания." />

        <StackPanel Grid.Row="7" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="100" Margin="0,0,8,0" Content="Отмена" Click="OnCancel" />
            <Button Width="110" Content="Сохранить" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
